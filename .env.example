# Copy to .env (gitignored) and fill only what you want to test. Never commit .env.
# Model access — needed for `robin ask` (or log in once with `claude`)
ANTHROPIC_API_KEY=

# Optional tools — fill, then `robin tools enable <name>`
POSTHOG_MCP_URL=
POSTHOG_API_KEY=
NOTION_MCP_URL=
NOTION_TOKEN=
GMAIL_MCP_URL=
GMAIL_TOKEN=
CALENDAR_MCP_URL=
CALENDAR_TOKEN=
BIGQUERY_MCP_URL=
BIGQUERY_TOKEN=
GITHUB_MCP_URL=
GITHUB_TOKEN=

# Slack DM interface (listener not built yet)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
